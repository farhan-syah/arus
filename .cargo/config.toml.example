# Copy to .cargo/config.toml for ignored machine config.
[alias]
check-all = "check --workspace --all-targets --locked --offline"

# Activate overrides only when adding and checking local sibling checkouts.
# Committed Cargo.toml and Cargo.lock stay pinned to published crates.io versions.
# [patch.crates-io]
# hydr = { path = "../rust-llm/hydr" }
# numr = { path = "../rust-llm/numr" }
# solvr = { path = "../rust-llm/solvr" }
# nodedb-lite = { path = "../NodeDB/nodedb-lite/nodedb-lite" }
# boostr = { path = "../rust-llm/boostr" }
# treeboost = { path = "../rust-llm/TreeBoost" }
