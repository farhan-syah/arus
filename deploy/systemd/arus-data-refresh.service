[Unit]
Description=Collect due ARUS public data
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=arus
Group=arus
StateDirectory=arus
ExecStart=/opt/arus/bin/arus-cli --catalog /etc/arus/sources.json --collections /etc/arus/collections.json --data-dir /var/lib/arus/acquisition data refresh
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/arus
